{
  "schema": 3,
  "framework_api": "3.0.0",
  "plugin_id": "dujiao-shop",
  "name": "独角数卡商城助手",
  "version": "2.2.0",
  "min_framework": "3.0.0",
  "author": "local",
  "notes": "v2.2.0：下单后自动轮询订单状态最长5分钟，支付成功立即返回订单结果与卡密，超时提示支付超时；支付链接先发一条消息再轮询，轮询间隔/超时可用 DJ_POLL_INTERVAL_MS / DJ_POLL_TIMEOUT_MS 覆盖。",
  "runtime": {
    "entry": "bin/node-win-x64.exe",
    "args": [
      "index.js"
    ],
    "transport": "native-ipc-v1",
    "api_version": "1",
    "admin": true,
    "actions": [
      "get_plugin_context",
      "get_bot_list",
      "get_protocol_list",
      "send_friend_msg",
      "send_group_msg"
    ],
    "events": [
      "friend_message",
      "group_message",
      "friend_event",
      "group_event",
      "bot_online",
      "bot_offline"
    ]
  }
}