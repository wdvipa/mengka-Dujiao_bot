{
  "schema": 3,
  "framework_api": "3.0.0",
  "plugin_id": "dujiao-shop",
  "name": "独角数卡商城助手",
  "version": "2.4.0",
  "min_framework": "3.0.7",
  "author": "local",
  "notes": "v2.4.0：适配 Windows amd64 / Linux amd64 / Linux arm64 三平台；min_framework 提升到 3.0.7；Linux 入口带 0755 权限位。",
  "runtime": {
    "entry": "bin/node-win-x64.exe",
    "args": [
      "index.js"
    ],
    "transport": "native-ipc-v1",
    "api_version": "1",
    "admin": true,
    "actions": [
      "get_plugin_context",
      "get_bot_list",
      "get_protocol_list",
      "send_friend_msg",
      "send_group_msg"
    ],
    "events": [
      "friend_message",
      "group_message",
      "friend_event",
      "group_event",
      "bot_online",
      "bot_offline"
    ]
  }
}