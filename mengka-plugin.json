{
  "schema": 3,
  "framework_api": "3.0.0",
  "plugin_id": "dujiao-shop",
  "name": "独角数卡商城助手",
  "version": "2.3.0",
  "min_framework": "3.0.0",
  "author": "local",
  "notes": "v2.3.0：打包压缩 exe 减小体积（89MB→34MB）、补充 openssl.cnf 沙箱运行环境、修复管理端最近日志栏不显示、打包脚本改用 raw deflate 修复 zip 损坏。",
  "runtime": {
    "entry": "bin/node-win-x64.exe",
    "args": [
      "index.js"
    ],
    "transport": "native-ipc-v1",
    "api_version": "1",
    "admin": true,
    "actions": [
      "get_plugin_context",
      "get_bot_list",
      "get_protocol_list",
      "send_friend_msg",
      "send_group_msg"
    ],
    "events": [
      "friend_message",
      "group_message",
      "friend_event",
      "group_event",
      "bot_online",
      "bot_offline"
    ]
  }
}