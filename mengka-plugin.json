{
  "schema": 3,
  "framework_api": "3.0.0",
  "plugin_id": "dujiao-shop",
  "name": "独角数卡商城助手",
  "version": "2.2.1",
  "min_framework": "3.0.0",
  "author": "local",
  "notes": "v2.2.1：修复管理端「最近日志」栏不显示——增加内存日志环并在 snapshot 返回 logs；补充收到指令、下单成功等关键日志。",
  "runtime": {
    "entry": "bin/node-win-x64.exe",
    "args": [
      "index.js"
    ],
    "transport": "native-ipc-v1",
    "api_version": "1",
    "admin": true,
    "actions": [
      "get_plugin_context",
      "get_bot_list",
      "get_protocol_list",
      "send_friend_msg",
      "send_group_msg"
    ],
    "events": [
      "friend_message",
      "group_message",
      "friend_event",
      "group_event",
      "bot_online",
      "bot_offline"
    ]
  }
}